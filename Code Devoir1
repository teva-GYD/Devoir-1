        }
        public class Catalogue : IEnumerable<Equipement>
        {
            private List<Equipement> equipements;

            public Catalogue()
            {
                equipements = new List<Equipement>();
            }

            public void AjouterEquipement(Equipement equipement)
            {
                foreach(Equipement e in equipements)
                {
                    if (equipement.Code == e.Code)
                    {
                        throw new ArgumentException("Le code existe déjà.");
                    }
                }
                equipements.Add(equipement);
            }
            public Equipement this[int index]
            {
                get
                {
                    return equipements[index];
                }
            }
            public Equipement this[string code]
            {
                get
                {
                    foreach (Equipement e in equipements)
                    {
                        if (e.Code == code)
                        {
                            return e;
                        }
                    }

                    throw new KeyNotFoundException("Aucun équipement ne possède ce code.");
                }
            }
            public IEnumerator<Equipement> GetEnumerator()
            {
                return equipements.GetEnumerator();
            }
            IEnumerator IEnumerable.GetEnumerator()
            {
                return GetEnumerator();
            }
        }
