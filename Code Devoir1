        public interface IDepotGarantie
        {
            float CalculerDepotGarantie();
        }
        public abstract class Equipement
        {
            private string code;
            private string nom;
            private float tarif;
            private int quantitedispo;
            private int seuilmini;
            public event Action<Equipement> StockBas;
            public string Code
            {
                get { return code; }
            }
            public string Nom
            {
                get { return nom; }
                private set
                {
                    if (string.IsNullOrEmpty(value))
                        throw new ArgumentException("Le nom ne peut pas être vide.");
                    nom = value;
                }
            }
            public float Tarif
            {
                get { return tarif; }
                private set 
                { 
                    if (value <= 0) 
                        throw new ArgumentException("Le tarif par jour doit être supérieur à 0.");
                    tarif = value; 
                }
            }
            public int QuantiteDispo
            {
                get { return quantitedispo; }
                private set
                {
                    if (value < 0)
                        throw new ArgumentException("La quantité disponible ne peut pas être négative.");

                    quantitedispo = value;
                }
            }
            public int SeuilMini
            {
                get { return seuilmini; }
                private set
                {
                    if (value < 0)
                        throw new ArgumentException("Le seuil minimal ne peut être négatif.");
                    seuilmini = value;
                }
            }

            protected Equipement(
                string code,
                string nom,
                float tarif,
                int quantitedispo,
                int seuilmini)
            {
                if (string.IsNullOrWhiteSpace(code))
                    throw new ArgumentException("Le code ne peut pas être vide.");

                this.code = code;
                Nom = nom;
                Tarif = tarif;
                QuantiteDispo = quantitedispo;
                SeuilMini = seuilmini;
            }

            public abstract float CalculerCoutLocation(int nombreJours);        //Dis que chaque classe fille doit donner sa version de calculer cout location

            public void RetirerUneUnite()
            {
                if (quantitedispo <= 0)
                    throw new InvalidOperationException("Il n'y a plus d'unité disponible.");
                quantitedispo--;
                if (quantitedispo < seuilmini)
                {
                    StockBas?.Invoke(this);
                }

            }
        }
        public class Portable : Equipement, IDepotGarantie
        {
            private int quantiteRam;
            public int QuantiteRam
            {
                get { return quantiteRam; }
                private set
                {
                    if (value <= 0)
                        throw new ArgumentException("La quantité de Ram doit être superieur à 0.");
                    quantiteRam = value;
                }
            }
            public Portable(
                string code,
                string nom,
                float tarif,
                int quantitedispo,
                int seuilmini,
                int quantiteRam)
                : base(code, nom, tarif, quantitedispo, seuilmini)
            {
                QuantiteRam = quantiteRam;
            }
            public override float CalculerCoutLocation(int nombreJours)
            {
                if (nombreJours <= 0)
                    throw new ArgumentException("Le nombre de jours doit être supérieur à 0.");
                return Tarif * nombreJours;
            }
            public float CalculerDepotGarantie()
            {
                return Tarif * 3;                                                                               //Valeur 3 mise aleatoirement
            }
        }
        public class Projecteur : Equipement
        {
            private int puissanceLumi;
            public int PuissanceLumi
            {
                get { return puissanceLumi; }
                private set
                {
                    if (value <= 0)
                        throw new ArgumentException("La puissance doit être superieur à 0.");
                    puissanceLumi = value;
                }
            }
            public Projecteur(
                string code,
                string nom,
                float tarif,
                int quantitedispo,
                int seuilmini,
                int puissanceLumi)
                : base(code, nom, tarif, quantitedispo, seuilmini)
            {
                PuissanceLumi = puissanceLumi;
            }
            public override float CalculerCoutLocation(int nombreJours)
            {
                if (nombreJours <= 0)
                    throw new ArgumentException("Le nombre de jours doit être supérieur à 0.");
                return Tarif * nombreJours * 1.1f;                                                                 //Valeur 1.1 mise aleatoirement pour faire un calcul different des autres
            }
        }
